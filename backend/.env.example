PORT=5000
MONGODB_URL=mongodb://localhost:27017/foodconnect
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# ImageKit Configuration (for image uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Cloudinary Configuration (Optional alternative)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration (for payment processing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gmail / Nodemailer Configuration (for OTP verification)
EMAIL=your_email@gmail.com
PASS=your_gmail_app_password
